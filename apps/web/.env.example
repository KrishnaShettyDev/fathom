# Server-only. Use a publishable (or legacy anon) key, never a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional until provider setup. Shared encrypted credential storage is server-only.
APP_ORIGIN=
DATABASE_URL=
CREDENTIAL_KEY_VERSION=
CREDENTIAL_KEYS_JSON=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enable the UI only after the worker observation provider is configured.
# Keep the actual model API key in the worker environment only.
OBSERVATIONS_ENABLED=false
OBSERVATION_MODEL=
