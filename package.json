{
  "name": "marketing-os",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "npm run dev --workspace=@marketing-os/web",
    "dev:worker": "npm run dev --workspace=@marketing-os/worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "db:types": "node scripts/generate-database-types.mjs",
    "test:auth": "npm run test:auth --workspace=@marketing-os/web",
    "db:configure": "node scripts/configure-local.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
